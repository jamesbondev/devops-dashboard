# Copy to .env (git-ignored) and fill in. Values here override config/dashboard.yaml.

# --- Azure DevOps ---------------------------------------------------------
# mock = synthetic data (no network). live = real Azure DevOps (needs ADO_PAT).
ADO_MODE=mock
ADO_ORGANIZATION=your-org
ADO_PROJECT=YourProject
# Org-scoped PAT, read-only scopes: Code (Read), Build (Read), Project and Team (Read),
# Test Management (Read), Identity (Read), Graph (Read). Max lifetime 1 year.
ADO_PAT=

# --- Auditor (Copilot) ----------------------------------------------------
# Shared secret between app and auditor; any long random string (e.g. `openssl rand -hex 32`).
AUDITOR_TOKEN=change-me-to-a-long-random-string
# mock = heuristic engine (no Copilot). copilot = GitHub Copilot SDK (run `docker compose run --rm auditor login` first).
AUDITOR_ENGINE=mock
# Optional alternative to the device-code login: fine-grained GitHub PAT with the "Copilot Requests" permission.
COPILOT_GITHUB_TOKEN=
# Optional fallback model id if config audit.model is unavailable on your seat.
AUDITOR_DEFAULT_MODEL=

# --- Misc -----------------------------------------------------------------
# Look up latest NuGet/Terraform versions during scans (needs internet from the container).
PACKAGE_LOOKUPS=true
DASHBOARD_PORT=8080
TZ=Europe/London
