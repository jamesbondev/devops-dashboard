<span class="pill pill--@Tier.ToLowerInvariant()" title="@Tooltip">@Tier@if (Provisional) {<span class="pill__sub">*</span>}</span>
@code {
    [Parameter] public string Tier { get; set; } = "None";
    [Parameter] public bool Provisional { get; set; }
    private string Tooltip => Provisional ? "Provisional: the next tier is blocked only by rules with insufficient data" : $"{Tier} tier";
}
