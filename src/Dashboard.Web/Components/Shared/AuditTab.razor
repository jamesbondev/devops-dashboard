@using Dashboard.Core.Contracts
@using System.Text.Json
@inject FindingsService FindingsSvc
@inject IClock Clock

@{
    var latest = Detail.Audits.FirstOrDefault(a => a.Status == AuditStatus.Succeeded);
    var running = Detail.Audits.FirstOrDefault(a => a.Status is AuditStatus.Queued or AuditStatus.Running);
    var failedLast = Detail.Audits.FirstOrDefault() is { Status: AuditStatus.Failed } f0 ? f0 : null;
}
<div class="row mb-3">
    <button class="btn btn--primary" @onclick="AuditNow" disabled="@(_queued || running is not null)">@(running is not null ? $"Audit {running.Status.ToString().ToLowerInvariant()}…" : _queued ? "Queued…" : "Audit now")</button>
    <span class="tone-muted text-sm">Audits re-run automatically when the default branch moves (at most once per @Config.Current.Audit.MinHoursBetweenAudits h unless build/deploy files change). Facts are computed statically; Copilot judges the rest with read-only access to an immutable worktree.</span>
</div>
@if (failedLast is not null) { <div class="banner banner--warn">Last audit failed <Ago At="failedLast.CompletedAt" />: @failedLast.Error</div> }

@if (latest is null) { <div class="empty">No completed audit yet.</div> }
else
{
    <section class="panel mb-4">
        <header class="panel__head"><h2>Checks &amp; findings</h2><span class="panel__meta"><label><input type="checkbox" @bind="_hidePass" /> hide passing</label></span></header>
        <div class="table-wrap">
        <table class="t findings">
            <colgroup><col style="width:15%" /><col style="width:8%" /><col style="width:42%" /><col style="width:20%" /><col style="width:15%" /></colgroup>
            <thead><tr><th>Check</th><th>Result <Info Text="Kind under the result: fact = computed by the static scanner; judgement = assessed by Copilot." Term="fact" /></th><th>Finding</th><th>Evidence</th><th>Status <Info Text="New → Accepted / Dismissed; Done when a later audit no longer reports it." Term="finding-status" /></th></tr></thead>
            <tbody>
            @foreach (var row in Detail.Findings.Where(x => !_hidePass || x.Finding.Result is not (CheckResult.Pass or CheckResult.NotApplicable)))
            {
                var fnd = row.Finding;
                <tr>
                    <td><code>@fnd.CheckId</code><div class="text-sm tone-muted">@fnd.Title</div>@if (fnd.Component is not null) { <span class="chip">@fnd.Component</span> }</td>
                    <td>@ResultBadge(fnd.Result) @if (fnd.Uncertain) { <span class="pill pill--warn" title="votes disagreed or evidence could not be verified">uncertain</span> } <div><span class="pill pill--@(fnd.Severity == "high" ? "bad" : fnd.Severity == "medium" ? "warn" : "")">@fnd.Severity</span></div><div class="tone-muted text-sm">@fnd.Kind</div></td>
                    <td class="text-sm finding"><div>@fnd.Explanation</div>@if (!string.IsNullOrWhiteSpace(fnd.Recommendation)) { <div class="do"><b>Do:</b> @fnd.Recommendation</div> }</td>
                    <td class="text-sm mono ev">@foreach (var ev in Evidence(fnd).Take(4)) { <div title="@ev">@ShortPath(ev)</div> }</td>
                    <td>@if (row.State is { } st) { <span class="pill pill--@(st.Status == FindingStatus.Done ? "ok" : st.Status == FindingStatus.Dismissed ? "" : "warn")" title="@st.Reason">@st.Status</span> }
                    <div class="factions">
                        @if (row.State is { } s2 && fnd.Result is CheckResult.Fail or CheckResult.Partial)
                        {
                            @if (s2.Status == FindingStatus.New) { <button class="btn btn--secondary" @onclick="() => Set(s2.Fingerprint, FindingStatus.Accepted, null)">Accept</button> }
                            @if (s2.Status != FindingStatus.Dismissed)
                            {
                                <select class="select" value="@(_reason.GetValueOrDefault(s2.Fingerprint) ?? "")" @onchange="e => _reason[s2.Fingerprint] = e.Value?.ToString()"><option value="">dismiss…</option><option>won't fix</option><option>false positive</option><option>not applicable</option></select>
                                <button class="btn btn--secondary" disabled="@(string.IsNullOrEmpty(_reason.GetValueOrDefault(s2.Fingerprint)))" @onclick="() => Set(s2.Fingerprint, FindingStatus.Dismissed, _reason.GetValueOrDefault(s2.Fingerprint))">Dismiss</button>
                            }
                            else { <button class="btn btn--secondary" @onclick="() => Set(s2.Fingerprint, FindingStatus.New, null)">Reopen</button> }
                        }
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </section>
    <div class="grid-2">
        <section class="panel">
            <header class="panel__head"><h2>Latest audit</h2><span class="panel__meta">@Dashboard.Web.Services.Fmt.ShortSha(latest.Sha) · <Ago At="latest.CompletedAt" /> · @latest.Engine @latest.Model · rubric @latest.RubricVersion @(latest.Votes > 1 ? $"· {latest.Votes} votes" : "") @if (latest.IsBaseline) { <span class="pill pill--info" title="Model, rubric or prompt changed — not compared with earlier audits">baseline</span> }</span></header>
            <p><b>Architecture:</b> <span class="pill pill--info">@latest.ArchitectureStyle</span></p>
            @if (Result(latest) is { } r)
            {
                <p class="text-sm prose clamp-3 is-click @(_openRationale ? "is-open" : "")" @onclick="() => _openRationale = !_openRationale" title="Click to expand">@r.ArchitectureRationale</p>
                @if (r.ArchitectureEvidence.Count > 0) { <div class="text-sm tone-muted">Evidence: @string.Join(", ", r.ArchitectureEvidence.Select(e => e.Path + (e.Line is { } l ? $":{l}" : "")))</div> }
                <h3>Summary</h3><p class="prose clamp-3 @(_openSummary ? "is-open" : "")">@r.Summary</p>
                <button class="clamp-toggle" @onclick="() => _openSummary = !_openSummary">@(_openSummary ? "less" : "more")</button>
                @if (r.AzureDependencies.Count > 0) { <p><b>Azure dependencies:</b> @string.Join(", ", r.AzureDependencies)</p> }
            }
        </section>
        <section class="panel">
            <header class="panel__head"><h2>Since previous audit</h2></header>
            @{
                var prev = Detail.Audits.Where(a => a.Status == AuditStatus.Succeeded && a.Id != latest.Id).FirstOrDefault();
                var newCount = Detail.Findings.Count(x => x.State is { } s && prev is not null && s.FirstSeen > prev.CompletedAt);
                var openCount = Detail.Findings.Count(x => x.State?.Status is FindingStatus.New or FindingStatus.Accepted);
            }
            <div class="kpi-row">
                <div class="kpi"><div class="kpi__label">Open findings</div><div class="kpi__value">@openCount</div></div>
                <div class="kpi"><div class="kpi__label">New since previous</div><div class="kpi__value">@(prev is null ? "—" : newCount.ToString())</div></div>
                <div class="kpi"><div class="kpi__label">Checks passing</div><div class="kpi__value">@Detail.Findings.Count(x => x.Finding.Result == CheckResult.Pass)</div></div>
            </div>
            @if (latest.IsBaseline) { <p class="text-sm tone-muted">This audit is a new baseline (model/rubric/prompt changed); "new" counts start from here.</p> }
        </section>
    </div>

}

<section class="panel mt-4">
    <header class="panel__head"><h2>Audit history</h2></header>
    <table class="t">
        <thead><tr><th>When</th><th>SHA</th><th>Status</th><th>Engine / model</th><th>Rubric</th><th>Trigger</th><th class="num">Duration</th><th>Transcript</th></tr></thead>
        <tbody>
        @foreach (var a in Detail.Audits)
        {
            <tr>
                <td><Ago At="a.CreatedAt" /></td><td class="mono">@Dashboard.Web.Services.Fmt.ShortSha(a.Sha)</td>
                <td><span class="pill pill--@(a.Status == AuditStatus.Succeeded ? "ok" : a.Status == AuditStatus.Failed ? "bad" : "info")">@a.Status</span> @if (a.IsBaseline) { <span class="pill pill--info">baseline</span> }</td>
                <td>@a.Engine @a.Model</td><td>@a.RubricVersion</td><td class="tone-muted">@a.Trigger</td>
                <td class="num">@(a.DurationMs is { } ms ? $"{ms / 1000.0:0}s" : "—")</td>
                <td>@if (a.Status == AuditStatus.Succeeded) { <a href="audit/@a.Id/transcript" target="_blank">view</a> }</td>
            </tr>
        }
        </tbody>
    </table>
</section>

@code {
    [Parameter, EditorRequired] public RepoDetail Detail { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Inject] ConfigService Config { get; set; } = default!;
    private bool _queued;
    private bool _hidePass = true;
    private bool _openSummary, _openRationale;
    private readonly Dictionary<string, string?> _reason = new();

    private async Task AuditNow()
    {
        _queued = true;
        await FindingsSvc.EnqueueAuditAsync(Detail.Health.Repo.Id, "manual");
        await OnChanged.InvokeAsync();
    }

    private async Task Set(string fp, FindingStatus s, string? reason)
    {
        await FindingsSvc.SetStatusAsync(fp, s, reason);
        await OnChanged.InvokeAsync();
    }

    private static AuditResult? Result(AuditRun a)
    {
        if (a.ResultJson is null) return null;
        try { return JsonSerializer.Deserialize<Dashboard.Core.Contracts.AuditResult>(a.ResultJson, Dashboard.Web.Ado.JsonDefaults.Web); }
        catch (JsonException) { return null; }
    }

    // "src/A/B/C.cs:12" -> "…/B/C.cs:12" (full path on hover)
    private static string ShortPath(string p)
    {
        var parts = p.Split('/');
        return parts.Length <= 2 ? p : "…/" + string.Join('/', parts[^2..]);
    }

    private static IEnumerable<string> Evidence(Finding f)
    {
        try { return (JsonSerializer.Deserialize<List<Dashboard.Core.Contracts.Evidence>>(f.EvidenceJson, Dashboard.Web.Ado.JsonDefaults.Web) ?? []).Select(e => e.Path + (e.Line is { } l ? $":{l}" : "")); }
        catch (JsonException) { return []; }
    }

    private static MarkupString ResultBadge(CheckResult r) => new(r switch
    {
        CheckResult.Pass => "<span class='pill pill--ok'>pass</span>",
        CheckResult.Partial => "<span class='pill pill--warn'>partial</span>",
        CheckResult.Fail => "<span class='pill pill--bad'>fail</span>",
        _ => "<span class='pill'>n/a</span>",
    });
}
