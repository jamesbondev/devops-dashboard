<span class="chip" title="@Title">@if (Kind is { } k) { <span class="chip__kind">@KindLabel(k)</span> }@Name</span>
@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public ComponentKind? Kind { get; set; }
    [Parameter] public string? Title { get; set; }
    private static string KindLabel(ComponentKind k) => k switch { ComponentKind.Database => "DB", ComponentKind.AksService => "AKS", _ => "" };
}
