@inject IClock Clock
@if (At is { } t) { <time class="ago" datetime="@t.ToString("o")" title="@Local(t)">@Fmt.Ago(t, Clock.UtcNow)</time> } else { <span class="tone-subtle">—</span> }
@code {
    [Parameter] public DateTimeOffset? At { get; set; }
    [Inject] ConfigService Config { get; set; } = default!;
    private string Local(DateTimeOffset t) => Config.WorkingHours.ToLocal(t).ToString("ddd dd MMM yyyy HH:mm") + " (local)";
}
