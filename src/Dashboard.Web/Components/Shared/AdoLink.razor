@if (!string.IsNullOrEmpty(Href)) { <a href="@Href" target="_blank" rel="noopener" title="Open in Azure DevOps">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, "↗")))</a> } else { @ChildContent }
@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
