@page "/weekly"
@inherits LivePage
@inject WeeklyService WeeklySvc
@inject IJSRuntime JS

<PageTitle>Weekly · DevOps Dashboard</PageTitle>
<header class="page-head">
    <div class="page-head__text">
        <h1>Weekly digest</h1>
        <p class="page-head__headline">for retros and sprint review — no per-person data</p>
    </div>
    <div class="page-head__actions">
        <button class="btn btn--secondary" @onclick="Copy">Copy Markdown</button>
    <button class="btn btn--secondary" @onclick="Download">Download .md</button>
    <button class="btn btn--primary" @onclick="Brief" disabled="@_busy">@(_busy ? "Writing…" : "Write brief with Copilot")</button>
    </div>
</header>
@if (_brief is not null) { <section class="panel mb-4"><header class="panel__head"><h2>Brief</h2></header><pre class="box">@_brief</pre></section> }
<section class="panel"><pre class="box is-full">@_digest</pre></section>

@code {
    private string _digest = "";
    private string? _brief;
    private bool _busy;
    protected override TimeSpan RefreshEvery => TimeSpan.FromMinutes(5);
    protected override async Task LoadAsync() => _digest = await WeeklySvc.DigestAsync();
    private async Task Copy() { try { await JS.InvokeAsync<bool>("dash.copy", _digest); } catch (JSException) { } }
    private async Task Download() { try { await JS.InvokeVoidAsync("dash.download", $"weekly-{Now:yyyy-MM-dd}.md", _digest); } catch (JSException) { } }
    private async Task Brief()
    {
        _busy = true;
        try { _brief = await WeeklySvc.BriefAsync(); }
        catch (Exception ex) { _brief = "Could not write the brief: " + ex.Message; }
        finally { _busy = false; }
    }
}
