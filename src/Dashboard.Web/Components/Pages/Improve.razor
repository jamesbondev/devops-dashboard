@page "/improve"
@page "/insights"
@page "/findings"
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Improve · DevOps Dashboard</PageTitle>
<header class="page-head">
    <div class="page-head__text">
        <h1>Improve</h1>
        <p class="page-head__headline">Where to invest: failures shared across repos, flakiness cost, fleet outliers and open audit findings.</p>
    </div>
</header>
<nav class="tabs">
    <a class="@(_tab == "insights" ? "is-active" : "")" href="insights">Insights</a>
    <a class="@(_tab == "findings" ? "is-active" : "")" href="findings">Audit findings</a>
</nav>
@if (_tab == "findings") { <FindingsSection /> } else { <InsightsSection /> }

@code {
    private string _tab = "insights";
    // Routes share this component, so Blazor reuses the instance (no parameters change) when switching
    // tabs; follow the URL directly.
    protected override void OnInitialized()
    {
        SetTab();
        Nav.LocationChanged += OnLocationChanged;
    }
    private void OnLocationChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(() => { SetTab(); StateHasChanged(); });
    private void SetTab()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _tab = path == "findings" ? "findings" : "insights";
    }
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
