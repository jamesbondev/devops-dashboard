@page "/repo/{Name}"
@inherits LivePage
@inject RepoDetailService Detail
@inject RepoAdminService Admin
@inject FindingsService FindingsSvc
@inject NavigationManager Nav

<PageTitle>@Name · DevOps Dashboard</PageTitle>

@if (LoadError is not null) { <div class="banner banner--bad">@LoadError</div> }
@if (_d is null)
{
    @if (!Loading) { <div class="empty">Repo <b>@Name</b> is not assigned to the dashboard. <a href="settings">Assign it in Admin → Settings</a>.</div> } else { <div class="empty">Loading…</div> }
}
else
{
    var h = _d.Health;
    <header class="page-head">
        <div class="page-head__text">
            <h1>@h.Repo.Name <TierBadge Tier="@h.Tier.Tier" Provisional="h.Tier.Provisional" />
                @if (h.Dormant) { <span class="pill">dormant</span> }</h1>
            <p class="page-head__headline"><span title="@(h.Type != h.Repo.Type ? "from repos config / name pattern" : "")">@RepoTypes.Label(h.Type)</span>
                @if (h.Components.Count > 0) { <span class="chip-list mt-1">@foreach (var c in h.Components) { <ComponentChip Name="@c.Name" Kind="c.Kind" Title="@($"{c.SourcePath} ({c.Source})")" /> }</span> }</p>
        </div>
        <div class="page-head__actions">
            <AdoLink Href="@h.Repo.WebUrl">Repo in ADO ↗</AdoLink>
            <button class="btn btn--secondary btn--sm" @onclick="TogglePin">@(h.Repo.Pinned ? "Unpin" : "Pin")</button>
            <button class="btn btn--secondary btn--sm" @onclick="ToggleMute">@(h.Repo.Muted ? "Unmute" : "Mute")</button>
            <select class="select select--sm" value="@h.Type" @onchange="ChangeType" title="Repo type selects the rule set (repos.types in config wins; name patterns apply while this is Service)">
                <option>Service</option><option>Library</option><option>Infra</option><option value="E2E">E2E tests</option><option value="Load">Load tests</option>
            </select>
            <a class="btn btn--secondary btn--sm" href="@($"export/repo/{Uri.EscapeDataString(h.Repo.Name)}.md")" target="_blank">Export .md</a>
        </div>
    </header>

    <div class="panel mb-4">
        @if (h.Tier.NextTier is { } nt)
        {
            <div><b>Why @h.Tier.Tier@(h.Tier.Provisional ? " (provisional)" : "")</b> — @(h.Tier.NextTierGaps.Count) rule@(h.Tier.NextTierGaps.Count == 1 ? "" : "s") from <b>@nt</b>:</div>
            <ul>
                @foreach (var g in h.Tier.NextTierGaps)
                {
                    <li><code>@g.RuleId</code> @g.Title — <span class="@(g.Status == RuleStatus.Insufficient ? "muted" : "bad")">@g.Display</span> @if (g.Status == RuleStatus.Insufficient) { <span class="pill">insufficient data</span> }
                        <Info Text="@(RuleCatalog.Known.GetValueOrDefault(g.RuleId)?.Formula ?? "")" /></li>
                }
            </ul>
        }
        else { <div><b>Gold</b> — every rule passes.</div> }
    </div>

    <nav class="tabs">
        @foreach (var t in new[] { "overview", "pipelines", "prs", "deployments", "templates", "audit" })
        {
            <a class="@(Tab == t ? "is-active" : "")" href="repo/@Uri.EscapeDataString(Name)?tab=@t">@TabTitle(t)</a>
        }
    </nav>

    @switch (Tab)
    {
        case "pipelines":
            <div class="grid-2">
                <section class="panel">
                    <header class="panel__head"><h2>Flaky jobs (@Config.Current.Metrics.WindowDays d)</h2><span class="panel__meta">@h.WastedMinutes.ToString("0") wasted minutes</span></header>
                    @if (h.FlakyJobs.Count == 0) { <div class="empty">No flaky jobs.</div> }
                    else
                    {
                        <table class="t"><thead><tr><th>Stage / job</th><th class="num">Occurrences</th><th class="num">Wasted min</th></tr></thead><tbody>
                        @foreach (var g in h.FlakyJobs.GroupBy(f => (f.StageName, f.JobName)).OrderByDescending(g => g.Sum(x => x.WastedMinutes)))
                        { <tr><td>@g.Key.StageName / @g.Key.JobName</td><td class="num">@g.Count()</td><td class="num">@g.Sum(x => x.WastedMinutes).ToString("0")</td></tr> }
                        </tbody></table>
                    }
                    @if (_d.TestFlakes.Count > 0)
                    {
                        <h3>Flaky tests</h3>
                        <table class="t"><tbody>@foreach (var g in _d.TestFlakes.GroupBy(t => t.TestName).OrderByDescending(g => g.Count()).Take(10)) { <tr><td class="mono text-sm">@g.Key</td><td class="num">@g.Count()×</td></tr> }</tbody></table>
                    }
                </section>
                <section class="panel">
                    <header class="panel__head"><h2>Top failure causes</h2><Info Text="First error per failed task, normalised (ids/paths/numbers removed) and hashed. Same fingerprint across repos usually means a platform/template issue — see Insights." /></header>
                    @if (_d.TopFailures.Count == 0) { <div class="empty">No failures recorded.</div> }
                    <table class="t"><tbody>
                    @foreach (var tf in _d.TopFailures) { <tr><td class="mono text-sm">@Trunc(Fmt.Msg(tf.Message), 180)</td><td class="num nowrap">@tf.Count runs</td><td><Ago At="tf.Last" /></td></tr> }
                    </tbody></table>
                </section>
            </div>
            <section class="panel mt-4">
                <header class="panel__head"><h2>Runs (last @Config.Current.Metrics.WindowDays days)</h2>
                    <span class="panel__meta"><label><input type="checkbox" @bind="_hidePr" /> hide PR builds</label></span></header>
                <div class="table-wrap">
                <table class="t">
                    <thead><tr><th>Build</th><th>Pipeline</th><th>Reason</th><th>Build stages</th><th>Stages</th><th class="num">Min</th><th class="person">By</th><th>Queued</th></tr></thead>
                    <tbody>
                    @foreach (var r in _d.Runs.Where(r => !_hidePr || !r.Run.IsPullRequest).Take(150))
                    {
                        <tr>
                            <td><AdoLink Href="@r.Run.WebUrl">@r.Run.BuildNumber</AdoLink></td>
                            <td>@r.PipelineName</td>
                            <td class="tone-muted">@r.Run.Reason</td>
                            <td>@OutcomeBadge(r.BuildOutcome, r.Run.Status) @if (r.FlakyJobs > 0) { <span class="pill pill--warn" title="a job failed then passed on retry">flaky</span> }</td>
                            <td><span class="dots">@foreach (var s in r.Stages) { <span class="dot @StageDot(s)" title="@s.Name: @(s.Result ?? s.State) (attempt @s.Attempt)"></span> }</span>
                                @if (r.FirstError is not null) { <div class="mono text-sm tone-muted">@Trunc(Fmt.Msg(r.FirstError), 140)</div> }</td>
                            <td class="num">@Fmt.Num(r.Minutes, "0")</td>
                            <td class="person tone-muted">@r.Run.RequestedFor</td>
                            <td><Ago At="r.Run.QueueTime" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </section>
            break;

        case "prs":
            <div class="kpi-row mb-4">
                <div class="kpi"><div class="kpi__label">Time to first review (@h.Prs.FirstReviewLabel)</div><div class="kpi__value">@Fmt.Num(h.Prs.FirstReviewHours)h</div><div class="kpi__sub">working hours, n=@h.Prs.ReviewedInWindow</div></div>
                <div class="kpi"><div class="kpi__label">Time to merge (@h.Prs.MergeLabel)</div><div class="kpi__value">@Fmt.Num(h.Prs.MergeHours)h</div><div class="kpi__sub">n=@h.Prs.CompletedInWindow</div></div>
                <div class="kpi"><div class="kpi__label">Active PRs</div><div class="kpi__value">@h.Prs.ActiveCount</div><div class="kpi__sub">@h.Prs.StuckCount stuck</div></div>
                <div class="kpi"><div class="kpi__label">Oldest active</div><div class="kpi__value">@Fmt.Num(h.Prs.OldestActiveWorkingDays)d</div><div class="kpi__sub">working days</div></div>
            </div>
            <section class="panel">
                <header class="panel__head"><h2>Pull requests</h2><span class="panel__meta">drafts and bots excluded from metrics</span></header>
                <table class="t">
                    <thead><tr><th>PR</th><th>Status</th><th class="person">Author</th><th>Waiting on</th><th class="num">1st review</th><th class="num">Merge</th><th>Created</th></tr></thead>
                    <tbody>
                    @foreach (var p in _d.RecentPrs)
                    {
                        <tr>
                            <td><AdoLink Href="@p.Pr.WebUrl">!@p.Pr.Id</AdoLink> @p.Pr.Title @if (p.Pr.IsDraft) { <span class="pill">draft</span> } @if (p.Pr.AuthorIsBot) { <span class="pill">bot</span> }</td>
                            <td>@if (p.Stuck) { <span class="pill pill--bad" title="@string.Join(", ", p.StuckReasons)">stuck</span> } else { <span class="pill pill--@(p.Pr.Status == "completed" ? "ok" : p.Pr.Status == "active" ? "info" : "")">@p.Pr.Status</span> }
                                @if (p.Pr.MergeStatus == "conflicts") { <span class="pill pill--bad">conflicts</span> } @if (p.Pr.PolicyStatus == "rejected") { <span class="pill pill--bad">policy</span> }</td>
                            <td class="person">@p.Pr.AuthorName</td>
                            <td class="person text-sm">@string.Join(", ", p.WaitingOn)</td>
                            <td class="num">@Fmt.Num(p.FirstReviewWorkingHours)</td>
                            <td class="num">@Fmt.Num(p.MergeWorkingHours)</td>
                            <td><Ago At="p.Pr.CreatedOn" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
            break;

        case "deployments":
            <div class="kpi-row mb-4">
                <div class="kpi"><div class="kpi__label">Deploys / week to Production <span class="kpi__window">@Config.Current.Metrics.WindowDays d</span></div><div class="kpi__value">@h.Delivery.DeploysPerWeek.ToString("0.#")</div><div class="kpi__sub">distinct component+version, sim or prod</div></div>
                <div class="kpi"><div class="kpi__label">Lead time, median <span class="kpi__window">@Config.Current.Metrics.WindowDays d</span></div><div class="kpi__value">@Fmt.Hours(h.Delivery.MedianLeadTimeHours ?? 0)</div><div class="kpi__sub">PR publish → first Production deploy</div></div>
                <div class="kpi"><div class="kpi__label">…of which approval wait <span class="kpi__window">median</span></div><div class="kpi__value">@Fmt.Hours(h.Delivery.MedianApprovalWaitHours ?? 0)</div><div class="kpi__sub">review @Fmt.Hours(h.Delivery.MedianReviewHours ?? 0) · pipeline @Fmt.Hours(h.Delivery.MedianMergeToDeployHours ?? 0)</div></div>
                <div class="kpi"><div class="kpi__label">Change failure (proxy) <span class="kpi__window">@Config.Current.Metrics.WindowDays d</span></div><div class="kpi__value">@Fmt.Pct(h.Delivery.ChangeFailureRateProxy)</div><div class="kpi__sub">failed Production deploy stages ÷ all</div></div>
            </div>
            <section class="panel mb-4">
                <header class="panel__head"><h2>Components × environments <span class="kpi__window">60 d</span></h2><Info Text="@($"Latest successful deployment per component and environment. This tab looks back 60 days; health metrics and the KPIs above use {Config.Current.Metrics.WindowDays} days. '= same' = same version as the environment to its left; ⚠ = Production-tier environments on different versions.")" Term="same" /></header>
                <DeployMatrix Rows="RepoMatrix()" Environments="RepoEnvironments()" ByRepo="false" />
            </section>
            <section class="panel">
                <header class="panel__head"><h2>Releases by version <span class="kpi__window">60 d</span></h2><Info Text="One row per build version: the environments it reached (✕ = a failed attempt there), overall result and the longest approval wait. Derived from pipeline stages matching an environment's stagePatterns." /></header>
                @{ var releases = Releases().ToList(); }
                @if (releases.Count == 0) { <div class="empty">No deployments in 60 d.</div> }
                else
                {
                <div class="table-wrap">
                <table class="t compact">
                    <thead><tr><th>Version</th><th>Component</th><th>Environments</th><th>Result</th><th class="num">Approval wait</th><th>Last</th></tr></thead>
                    <tbody>
                    @foreach (var r in releases.Take(60))
                    {
                        var (br, num) = Fmt.ShortVer(r.Version, h.Repo.Name);
                        <tr class="@(r.Failed && !r.Passed ? "is-bad" : "")">
                            <td class="nowrap" title="@r.Version">@if (br is not null && !Fmt.IsMainBranch(br)) { <span class="pill pill--ref is-nondefault" title="@br">@br</span> } <span class="ver">@num</span></td>
                            <td class="wrap text-sm">@string.Join(", ", r.Components)</td>
                            <td class="wrap"><span class="chip-list">@foreach (var e in r.Envs) { <span class="pill pill--env @Fmt.EnvClass(e.Name, Config.Current)" title="@(e.Ok ? "succeeded" : "failed")">@e.Name@(e.Ok ? "" : " ✕")</span> }</span></td>
                            <td class="nowrap">@if (r.Running) { <span class="pill pill--info">running</span> } else if (r.Failed && r.Passed) { <span class="pill pill--warn">partly failed</span> } else if (r.Failed) { <span class="pill pill--bad">failed</span> } else { <span class="pill pill--ok">passed</span> }</td>
                            <td class="num">@(r.MaxWaitHours > 0 ? Fmt.Hours(r.MaxWaitHours) : "—")</td>
                            <td class="nowrap"><Ago At="r.Last" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
                }
            </section>
            break;

        case "templates":
            <section class="panel">
                <header class="panel__head"><h2>Template compliance</h2><Info Text="From what actually ran (Runs - Get resources) plus a static YAML parse. main = compliant, next = experimental, anything else = non-compliant. Staleness is informational." /></header>
                <table class="t">
                    <thead><tr><th>Pipeline</th><th>Ref</th><th>Commit used</th><th>Behind head</th><th>extends</th><th>Inline bypass</th><th>Last run</th><th>Notes</th></tr></thead>
                    <tbody>
                    @foreach (var t in h.Templates)
                    {
                        <tr>
                            <td>@t.PipelineName</td>
                            <td>@RefBadge(t)</td>
                            <td class="mono">@Fmt.ShortSha(t.Sha)</td>
                            <td>@(t.CommitsBehind is { } b ? $"{b} commits / {t.DaysBehind:0}d" : "—") @if (t.Stale) { <span class="pill pill--warn">stale</span> }</td>
                            <td>@(t.UsesExtends ? "✓" : "✗")</td>
                            <td>@(t.InlineBypass ? $"{t.InlineStages} stages, {t.InlineJobs} jobs, {t.InlineSteps} steps" : "—")</td>
                            <td><Ago At="t.LastRunAt" /></td>
                            <td class="text-sm">@string.Join(" ", t.Notes)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <h3>Recent template changes</h3>
                <table class="t"><tbody>
                @foreach (var c in _d.TemplateCommits.Take(15)) { <tr><td><Ago At="c.Date" /></td><td><span class="pill pill--@(c.Branch == "main" ? "ok" : "info")">@c.Branch</span></td><td class="mono text-sm">@Fmt.ShortSha(c.Sha)</td><td>@c.Message</td></tr> }
                </tbody></table>
                <div class="mt-2"><button class="btn btn--secondary" @onclick="SummariseTemplates" disabled="@_busy">Summarise what re-running would pick up (Copilot)</button></div>
                @if (_templateSummary is not null) { <pre class="box">@_templateSummary</pre> }
            </section>
            break;

        case "audit":
            <AuditTab Detail="_d" OnChanged="ReloadAsync" />
            break;

        default:
            <div class="kpi-row mb-4">
                <div class="kpi"><div class="kpi__label">Main success (@Config.Current.Metrics.WindowDays d)</div><div class="kpi__value @(h.MainSuccessRate < 0.9 ? "bad" : "")">@Fmt.Pct(h.MainSuccessRate)</div><div class="kpi__sub">n=@h.CompletedBuildRuns @Trend(h.SuccessRateTrend)</div></div>
                <div class="kpi"><div class="kpi__label">Main red now</div><div class="kpi__value @(h.OpenRed is null ? "good" : "bad")">@(h.OpenRed is { } red ? Fmt.Hours((Now - red.Start).TotalHours) : "no")</div><div class="kpi__sub">longest @Fmt.Num(h.LongestRedWorkingHours)wh in window</div></div>
                <div class="kpi"><div class="kpi__label">Flaky run rate</div><div class="kpi__value">@Fmt.Pct1(h.FlakyRunRate)</div><div class="kpi__sub">@h.WastedMinutes.ToString("0") wasted min</div></div>
                <div class="kpi"><div class="kpi__label">Build duration (median)</div><div class="kpi__value">@Fmt.Num(h.MedianBuildMinutes, "0")m</div><div class="kpi__sub">build stages</div></div>
                <div class="kpi"><div class="kpi__label">Time to first review</div><div class="kpi__value">@Fmt.Num(h.Prs.FirstReviewHours)h</div><div class="kpi__sub">@h.Prs.FirstReviewLabel, working hours</div></div>
                <div class="kpi"><div class="kpi__label">Last Production deploy</div><div class="kpi__value text-sm"><Ago At="h.LastProductionDeploy?.FinishTime" /></div><div class="kpi__sub">@h.LastProductionDeploy?.EnvironmentName @h.LastProductionDeploy?.Version</div></div>
            </div>
            <div class="grid-2">
                <section class="panel">
                    <header class="panel__head"><h2>12-week trends</h2><span class="panel__meta">dashed = template release on main</span></header>
                    <table class="t"><tbody>
                        <tr><td>Main success rate</td><td><Spark Points="h.Weekly.Select(w => w.SuccessRate).ToList()" Min="0" Max="1" Width="260" Height="36" Markers="TemplateMarkers()" /></td></tr>
                        <tr><td>Flaky run rate</td><td><Spark Points="h.Weekly.Select(w => (double?)w.FlakyRate).ToList()" Min="0" Width="260" Height="36" Color="var(--warn)" Markers="TemplateMarkers()" /></td></tr>
                        <tr><td>Time to first review</td><td><Spark Points="h.Weekly.Select(w => w.FirstReviewHours).ToList()" Min="0" Width="260" Height="36" Color="var(--info)" /></td></tr>
                    </tbody></table>
                </section>
                <section class="panel">
                    @{ var outcomes = h.Tier.Outcomes.OrderBy(o => o.Status == RuleStatus.Fail ? 0 : o.Status == RuleStatus.Insufficient ? 1 : o.Status == RuleStatus.Pass ? 3 : 2).ThenBy(o => Array.IndexOf(TierResult.Order, o.Tier)).ToList();
                       var notPassing = outcomes.Where(o => o.Status != RuleStatus.Pass).ToList(); var passing = outcomes.Where(o => o.Status == RuleStatus.Pass).ToList(); }
                    <header class="panel__head"><h2>All rules</h2><span class="panel__meta">@passing.Count of @outcomes.Count passing</span></header>
                    <table class="t compact"><tbody>
                    @foreach (var o in _showPassingRules ? outcomes : notPassing) { @RuleRow(o) }
                    </tbody></table>
                    @if (passing.Count > 0) { <button class="clamp-toggle mt-2" @onclick="() => _showPassingRules = !_showPassingRules">@(_showPassingRules ? "Hide passing rules" : $"Show {passing.Count} passing rules")</button> }
                </section>
                <section class="panel @(_d.Policies.Count == 0 ? "is-empty" : "")" data-empty="No policies synced">
                    <header class="panel__head"><h2>Branch policies <span class="kpi__window">default branch</span></h2></header>
                    <div class="panel__body">
                    @{ var req = _d.Policies.Count(p => p.IsEnabled && p.IsBlocking); var opt = _d.Policies.Count(p => p.IsEnabled && !p.IsBlocking); var off = _d.Policies.Count(p => !p.IsEnabled); }
                    <details>
                        <summary><span class="tone-muted">@req required, @opt optional@(off > 0 ? $", {off} disabled" : "")</span></summary>
                        <table class="t compact mt-2"><tbody>
                        @foreach (var p in _d.Policies.OrderByDescending(p => p.IsEnabled && p.IsBlocking)) { <tr><td class="wrap">@p.TypeName</td><td class="nowrap"><span class="pill @(p.IsEnabled && p.IsBlocking ? "pill--info" : "")">@(p.IsEnabled ? (p.IsBlocking ? "required" : "optional") : "disabled")</span></td><td class="tone-muted text-sm nowrap">@p.RefName @(p.MinimumApproverCount is { } n ? $"min {n}" : "")</td></tr> }
                        </tbody></table>
                    </details>
                    </div>
                </section>
                <section class="panel">
                    <header class="panel__head"><h2>Facts</h2><span class="panel__meta">from the static scanner @(h.Facts is { } f ? $"@ {Fmt.ShortSha(f.Sha)}" : "")</span></header>
                    @if (h.Facts is not { } facts) { <div class="empty">Not scanned yet (scans run with audits).</div> }
                    else
                    {
                        <table class="t"><tbody>
                            <tr><td>Languages</td><td>@string.Join(", ", facts.Languages.FileCounts.OrderByDescending(kv => kv.Value).Take(5).Select(kv => $"{kv.Key} ({kv.Value})"))</td></tr>
                            <tr><td>.NET</td><td>@facts.Dotnet.Solutions.Count solution(s), @facts.Dotnet.Projects.Count project(s); @string.Join(", ", facts.Dotnet.TargetFrameworks) @if (facts.Dotnet.UnsupportedTargetFrameworks.Count > 0) { <span class="pill pill--bad">unsupported: @string.Join(", ", facts.Dotnet.UnsupportedTargetFrameworks)</span> }</td></tr>
                            <tr><td>Data</td><td>@DataSummary(facts)</td></tr>
                            <tr><td>Messaging</td><td>@(facts.Messaging.UsesServiceBus ? "Service Bus" : "") @(facts.Messaging.UsesMassTransit ? "MassTransit" : "") @(facts.Messaging.UsesNServiceBus ? "NServiceBus" : "") @string.Join(", ", facts.Messaging.QueueOrTopicNames.Take(6))</td></tr>
                            <tr><td>Azure services</td><td>@string.Join(", ", facts.AzureServices)</td></tr>
                            <tr><td>Deploy</td><td>@facts.Deploy.Skaffold.Sum(s => s.Artifacts.Count) skaffold artifact(s), @facts.Deploy.Dockerfiles.Count Dockerfile(s), @facts.Deploy.Workloads.Count k8s workload(s)</td></tr>
                        </tbody></table>
                    }
                </section>
            </div>
            break;
    }
}

@code {
    [Parameter] public string Name { get; set; } = "";
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    private string Tab => TabQuery ?? "overview";
    private RepoDetail? _d;
    private bool _hidePr = true;
    private bool _showPassingRules;

    private RenderFragment RuleRow(RuleOutcome o) => __builder =>
    {
        <tr><td class="nowrap"><code>@o.RuleId</code></td><td class="nowrap"><TierBadge Tier="@o.Tier" /></td><td class="wrap">@o.Title <Info Text="@(RuleCatalog.Known.GetValueOrDefault(o.RuleId)?.Formula ?? "")" /></td>
            <td class="nowrap">@RuleBadge(o.Status)</td><td class="text-sm wrap">@o.Display</td></tr>
    };

    private List<string> RepoEnvironments()
    {
        var used = _d!.Deployments.Select(d => d.EnvironmentName).ToHashSet();
        return Config.Current.Environments.OrderBy(e => e.Order).Select(e => e.Name).Where(used.Contains).ToList();
    }

    private IEnumerable<MatrixRow> RepoMatrix()
    {
        var h = _d!.Health;
        foreach (var g in _d.Deployments.GroupBy(d => d.ComponentId))
        {
            var comp = h.Components.FirstOrDefault(c => c.Id == g.Key);
            var cells = new Dictionary<string, MatrixCell>();
            foreach (var e in g.GroupBy(d => d.EnvironmentName))
            {
                var latest = e.Where(d => d.FinishTime is not null && ResultClassifier.Classify(d.Result, Config.Current.Results) == Outcome.Pass).MaxBy(d => d.FinishTime);
                var running = e.FirstOrDefault(d => d.FinishTime is null);
                cells[e.Key] = new MatrixCell(latest, running, false, 0);
            }
            var prodVersions = cells.Values.Where(c => c.Latest?.Tier == EnvironmentTier.Production).Select(c => c.Latest!.Version).Distinct().Count();
            if (prodVersions > 1)
                foreach (var k in cells.Keys.ToList()) if (cells[k].Latest?.Tier == EnvironmentTier.Production) cells[k] = cells[k] with { Drift = true };
            yield return new MatrixRow(h.Repo.Id, h.Repo.Name, comp, cells);
        }
    }

    private sealed record EnvHit(string Name, bool Ok);
    private sealed record Release(string? Version, List<string> Components, List<EnvHit> Envs, bool Passed, bool Failed, bool Running, double MaxWaitHours, DateTimeOffset? Last);

    private IEnumerable<Release> Releases()
    {
        var h = _d!.Health;
        var order = Config.Current.Environments.ToDictionary(e => e.Name, e => e.Order);
        return _d.Deployments.GroupBy(d => d.Version).Select(g =>
        {
            var outcomes = g.Select(d => (d, o: d.FinishTime is null ? (Outcome?)null : ResultClassifier.Classify(d.Result, Config.Current.Results))).ToList();
            var envs = g.GroupBy(d => d.EnvironmentName).OrderBy(e => order.GetValueOrDefault(e.Key, 99))
                .Select(e => new EnvHit(e.Key, e.Any(d => d.FinishTime is null || ResultClassifier.Classify(d.Result, Config.Current.Results) == Outcome.Pass))).ToList();
            return new Release(g.Key,
                g.Select(d => h.Components.FirstOrDefault(c => c.Id == d.ComponentId)?.Name ?? "(repo)").Distinct().ToList(),
                envs,
                outcomes.Any(x => x.o == Outcome.Pass), outcomes.Any(x => x.o == Outcome.Fail), outcomes.Any(x => x.o is null),
                g.Max(d => d.WaitSeconds) / 3600, g.Max(d => d.FinishTime ?? d.StartTime));
        }).OrderByDescending(r => r.Last);
    }
    private bool _busy;
    private string? _templateSummary;

    protected override async Task LoadAsync() => _d = await Detail.GetAsync(Name);
    private async Task ReloadAsync() { await SafeLoadAsync(); StateHasChanged(); }

    private async Task TogglePin() { await Admin.SetPinnedAsync(_d!.Health.Repo.Id, !_d.Health.Repo.Pinned); await ReloadAsync(); }
    private async Task ToggleMute() { await Admin.SetMutedAsync(_d!.Health.Repo.Id, !_d.Health.Repo.Muted); await ReloadAsync(); }
    private async Task ChangeType(ChangeEventArgs e) { if (Enum.TryParse<RepoType>(e.Value?.ToString(), out var t)) { await Admin.SetTypeAsync(_d!.Health.Repo.Id, t); await ReloadAsync(); } }

    private async Task SummariseTemplates()
    {
        _busy = true;
        try { _templateSummary = await FindingsSvc.SummariseTemplateChangesAsync(_d!); }
        catch (Exception ex) { _templateSummary = "Could not summarise: " + ex.Message; }
        finally { _busy = false; }
    }

    private IReadOnlyList<double> TemplateMarkers()
    {
        var start = Now.AddDays(-84);
        return _d!.TemplateCommits.Where(c => c.Branch == "main" && c.Date >= start).Select(c => (c.Date - start).TotalDays / 84).ToList();
    }

    private static string TabTitle(string t) => t switch { "prs" => "Pull requests", "pipelines" => "Pipelines", "deployments" => "Deployments", "templates" => "Templates", "audit" => "Audit", _ => "Overview" };
    private static string Trunc(string s, int n) => s.Length > n ? s[..n] + "…" : s;
    private static string StageDot(TimelineRecord s) => s.Result switch { "succeeded" => "ok", "failed" => "bad", "succeededWithIssues" => "warn", "skipped" => "", _ => s.State == "inProgress" ? "info pulse" : "" };

    private static MarkupString OutcomeBadge(Outcome o, string status) => new(status != "completed" ? "<span class='pill pill--info'>running</span>" : o switch
    {
        Outcome.Pass => "<span class='pill pill--ok'>passed</span>",
        Outcome.Fail => "<span class='pill pill--bad'>failed</span>",
        Outcome.Excluded => "<span class='pill'>excluded</span>",
        _ => "<span class='pill'>pending</span>",
    });

    private static MarkupString RuleBadge(RuleStatus s) => new(s switch
    {
        RuleStatus.Pass => "<span class='pill pill--ok'>pass</span>",
        RuleStatus.Fail => "<span class='pill pill--bad'>fail</span>",
        RuleStatus.Insufficient => "<span class='pill'>insufficient</span>",
        RuleStatus.Dormant => "<span class='pill'>dormant</span>",
        _ => "<span class='pill'>n/a</span>",
    });

    private static MarkupString RefBadge(PipelineTemplateStatus t) => new(t.RefStatus switch
    {
        TemplateRefStatus.Compliant => $"<span class='pill pill--ok'>{TemplateComplianceEvaluator.BranchName(t.Ref)}</span>",
        TemplateRefStatus.Experimental => $"<span class='pill pill--{(t.ExperimentalInProduction ? "warn" : "info")}'>{TemplateComplianceEvaluator.BranchName(t.Ref)} (experimental)</span>",
        TemplateRefStatus.NonCompliant => $"<span class='pill pill--bad'>{TemplateComplianceEvaluator.BranchName(t.Ref)}</span>",
        TemplateRefStatus.NoTemplate => "<span class='pill pill--bad'>no templates</span>",
        _ => "<span class='pill'>unknown</span>",
    });

    private static MarkupString Trend(double? delta) => delta is null ? new("") :
        new(delta >= 0.02 ? $"<span class='tone-ok'>▲ {delta:P0}</span>" : delta <= -0.02 ? $"<span class='tone-bad'>▼ {-delta:P0}</span>" : "<span class='tone-muted'>≈</span>");

    private static string DataSummary(Dashboard.Core.Scanners.RepoFacts f)
    {
        var parts = new List<string>();
        if (f.Data.UsesEfCore) parts.Add("EF Core");
        if (f.Data.UsesDapper) parts.Add("Dapper");
        if (f.Data.SqlProjects.Count > 0) parts.Add($"{f.Data.SqlProjects.Count} .sqlproj");
        if (f.Data.UsesDbUp) parts.Add("DbUp");
        parts.AddRange(f.Data.DatabaseEngines);
        return parts.Count == 0 ? "none detected" : string.Join(", ", parts.Distinct());
    }
