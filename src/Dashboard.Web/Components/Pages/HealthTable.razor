@page "/repos"
@inherits LivePage
@inject HealthService HealthSvc

<PageTitle>Health · DevOps Dashboard</PageTitle>

<header class="page-head">
    <div class="page-head__text">
        <h1>Health</h1>
        <p class="page-head__headline">@_all.Count repos · window @Config.Current.Metrics.WindowDays days · tiers are cumulative gates; <b>*</b> = provisional (blocked only by insufficient data)</p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary" href="export/health.md" target="_blank">Export Markdown</a>
    </div>
</header>

@if (LoadError is not null) { <div class="banner banner--bad">@LoadError</div> }

<div class="kpi-row mb-4">
    @foreach (var t in TierResult.Order.Reverse())
    {
        <div class="kpi"><div class="kpi__label"><TierBadge Tier="@t" /></div><div class="kpi__value">@_all.Count(h => h.Tier.Tier == t)</div><div class="kpi__sub">@_all.Count(h => h.Tier.Tier == t && h.Tier.Provisional) provisional</div></div>
    }
    <div class="kpi"><div class="kpi__label">Main red now</div><div class="kpi__value @(_all.Any(h => h.OpenRed is not null && !h.IsTestRepo) ? "bad" : "good")">@_all.Count(h => h.OpenRed is not null && !h.IsTestRepo)</div>@if (_all.Count(h => h.OpenRed is not null && h.IsTestRepo) is > 0 and var tf) { <div class="kpi__sub">+@tf test repo@(tf == 1 ? "" : "s") failing</div> }</div>
    <div class="kpi"><div class="kpi__label">Wasted minutes (flaky)</div><div class="kpi__value">@_all.Where(h => !h.IsTestRepo).Sum(h => h.WastedMinutes).ToString("0")</div><div class="kpi__sub">re-runs that later went green@(_all.Any(h => h.IsTestRepo) ? $" · test repos +{_all.Where(h => h.IsTestRepo).Sum(h => h.WastedMinutes):0}" : "")</div></div>
</div>

<div class="filters">
    <input type="search" class="input" placeholder="Filter repos…" @bind="_filter" @bind:event="oninput" />
    <label>Type <select class="select" @bind="_type"><option value="">all</option><option>Service</option><option>Library</option><option>Infra</option><option value="E2E">E2E tests</option><option value="Load">Load tests</option></select></label>
    <label>Tier <select class="select" @bind="_tier"><option value="">all</option><option>Gold</option><option>Silver</option><option>Bronze</option><option>None</option></select></label>
    <label><input type="checkbox" @bind="_changed" /> changed this week</label>
    <label><input type="checkbox" @bind="_redOnly" /> red now</label>
    <label><input type="checkbox" @bind="_showMuted" /> show muted</label>
    <label><input type="checkbox" @bind="_tiles" /> tiles</label>
</div>

@if (!_tiles)
{
<div class="table-wrap panel p-0">
<table class="t">
    <thead>
        <tr>
            <th class="sortable" @onclick='() => Sort("name")'>Repo</th>
            <th class="sortable" @onclick='() => Sort("tier")'>Tier <Info Text="Highest tier whose rules all pass. Hover a gap for details." /></th>
            <th>Next tier gap</th>
            <th class="sortable num" @onclick='() => Sort("red")'>Main red <Info Text="Open red interval on the default branch (build stages only; deploy failures don't count)." /></th>
            <th class="sortable num" @onclick='() => Sort("success")'>Main % <Info Text="Final build-stage outcome pass ÷ (pass+fail), default-branch non-PR runs. succeededWithIssues = fail; cancelled/skipped excluded." /></th>
            <th class="sortable num" @onclick='() => Sort("flaky")'>Flaky % <Info Text="Runs with ≥1 job whose earlier attempt failed and final attempt passed ÷ completed runs." /></th>
            <th class="sortable num" @onclick='() => Sort("wasted")'>Wasted min</th>
            <th class="sortable num" @onclick='() => Sort("review")'>1st review <Info Text="Working hours from publish to first human non-author vote/comment. Median when n<20, p85 when n≥20." /></th>
            <th class="sortable num" @onclick='() => Sort("oldest")'>Oldest PR</th>
            <th class="sortable" @onclick='() => Sort("prod")'>Last Production</th>
            <th>Templates</th>
            <th>Audit</th>
            <th>12-wk main %</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var h in Rows)
    {
        <tr>
            <td><a href="repo/@Uri.EscapeDataString(h.Repo.Name)"><b>@h.Repo.Name</b></a> <span class="tone-muted text-sm">@RepoTypes.Label(h.Type)</span>
                @if (h.Dormant) { <span class="pill">dormant</span> } @if (h.Repo.Muted) { <span class="pill">muted</span> } @if (h.Repo.Pinned) { <span class="pill pill--info">pinned</span> }
                <div class="chip-list mt-1">@foreach (var c in h.Components) { <ComponentChip Name="@c.Name" Kind="c.Kind" /> }</div></td>
            <td class="nowrap"><TierBadge Tier="@h.Tier.Tier" Provisional="h.Tier.Provisional" /> @TierMove(h)</td>
            <td class="gap">@if (h.Tier.NextTier is { } nt) { <span title="@string.Join("\n", h.Tier.NextTierGaps.Select(g => $"{g.RuleId} {g.Title}: {g.Display} ({g.Status})"))">@nt: @(h.Tier.NextTierGaps.Count) rule@(h.Tier.NextTierGaps.Count == 1 ? "" : "s") — @string.Join(", ", h.Tier.NextTierGaps.Take(2).Select(g => g.RuleId))</span> } else { <span class="tone-ok">top tier</span> }</td>
            <td class="num">@if (h.OpenRed is { } red) { <span class="pill pill--bad">red @Fmt.Hours((Now - red.Start).TotalHours)</span> } else { <span class="tone-ok">●</span> }</td>
            <td class="num @(h.MainSuccessRate < 0.9 && !h.IsTestRepo ? "bad" : "")" title="@(h.IsTestRepo ? "Test pass rate on main (test repo)" : "")">@Fmt.Pct(h.MainSuccessRate) <span class="tone-muted text-sm">n=@h.CompletedBuildRuns</span></td>
            <td class="num @(h.FlakyRunRate >= 0.05 ? "warnc" : "")">@Fmt.Pct1(h.FlakyRunRate)</td>
            <td class="num">@h.WastedMinutes.ToString("0")</td>
            <td class="num">@(h.Prs.FirstReviewHours is { } fr ? $"{fr:0.#}h" : "—") <span class="tone-muted text-sm">@h.Prs.FirstReviewLabel n=@h.Prs.ReviewedInWindow</span></td>
            <td class="num @(h.Prs.OldestActiveWorkingDays > 5 ? "warnc" : "")">@(h.Prs.OldestActiveWorkingDays is { } od ? $"{od:0.#}d" : "—")</td>
            <td>@if (h.LastProductionDeploy is { } lp) { <Ago At="lp.FinishTime" /> <span class="tone-muted text-sm">@lp.EnvironmentName</span> } else { <span class="tone-muted">never</span> }</td>
            <td>@TemplateSummary(h)</td>
            <td>@if (h.LatestAudit is { } a) { <Ago At="a.CompletedAt" /> @if (h.OpenFindings > 0) { <span class="pill pill--warn">@h.OpenFindings open</span> } } else { <span class="tone-muted">—</span> }</td>
            <td><Spark Points="h.Weekly.Select(w => w.SuccessRate).ToList()" Min="0" Max="1" Label="weekly main success rate" /></td>
        </tr>
    }
    </tbody>
</table>
</div>
}
else
{
    <div class="grid-3">
    @foreach (var h in Rows)
    {
        <div class="panel">
            <header><h2><a href="repo/@Uri.EscapeDataString(h.Repo.Name)">@h.Repo.Name</a></h2><span class="panel__meta"><TierBadge Tier="@h.Tier.Tier" Provisional="h.Tier.Provisional" /></span></header>
            <div class="row text-sm">
                <span>Main @Fmt.Pct(h.MainSuccessRate)</span><span>Flaky @Fmt.Pct1(h.FlakyRunRate)</span><span>1st review @(h.Prs.FirstReviewHours is { } fr ? $"{fr:0.#}h" : "—")</span>
                @if (h.OpenRed is not null) { <span class="pill pill--bad">red</span> }
            </div>
            <Spark Points="h.Weekly.Select(w => w.SuccessRate).ToList()" Min="0" Max="1" Width="260" />
        </div>
    }
    </div>
}

@code {
    private IReadOnlyList<RepoHealth> _all = [];
    private string _filter = "", _type = "", _tier = "", _sort = "tier";
    private bool _desc, _changed, _redOnly, _showMuted, _tiles;

    protected override async Task LoadAsync() => _all = await HealthSvc.GetAllAsync();

    private IEnumerable<RepoHealth> Rows
    {
        get
        {
            var q = _all.Where(h => (_showMuted || !h.Repo.Muted)
                                    && (_filter.Length == 0 || h.Repo.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase))
                                    && (_type.Length == 0 || h.Type.ToString() == _type)
                                    && (_tier.Length == 0 || h.Tier.Tier == _tier)
                                    && (!_redOnly || h.OpenRed is not null)
                                    && (!_changed || (h.PreviousTier is not null && h.PreviousTier != h.Tier.Tier) || h.Weekly.Count > 1 && Math.Abs((h.Weekly[^1].SuccessRate ?? 0) - (h.Weekly[^2].SuccessRate ?? 0)) > 0.1));
            // Default "worst first": tier asc, then red, then success rate asc. Pinned first.
            IOrderedEnumerable<RepoHealth> o = q.OrderByDescending(h => h.Repo.Pinned);
            o = _sort switch
            {
                "name" => _desc ? o.ThenByDescending(h => h.Repo.Name) : o.ThenBy(h => h.Repo.Name),
                "success" => _desc ? o.ThenByDescending(h => h.MainSuccessRate ?? 2) : o.ThenBy(h => h.MainSuccessRate ?? 2),
                "flaky" => _desc ? o.ThenBy(h => h.FlakyRunRate ?? -1) : o.ThenByDescending(h => h.FlakyRunRate ?? -1),
                "wasted" => _desc ? o.ThenBy(h => h.WastedMinutes) : o.ThenByDescending(h => h.WastedMinutes),
                "review" => _desc ? o.ThenBy(h => h.Prs.FirstReviewHours ?? -1) : o.ThenByDescending(h => h.Prs.FirstReviewHours ?? -1),
                "oldest" => _desc ? o.ThenBy(h => h.Prs.OldestActiveWorkingDays ?? -1) : o.ThenByDescending(h => h.Prs.OldestActiveWorkingDays ?? -1),
                "red" => _desc ? o.ThenBy(h => h.OpenRed?.Start ?? DateTimeOffset.MaxValue) : o.ThenBy(h => h.OpenRed is null).ThenBy(h => h.OpenRed?.Start),
                "prod" => _desc ? o.ThenByDescending(h => h.LastProductionDeploy?.FinishTime) : o.ThenBy(h => h.LastProductionDeploy?.FinishTime ?? DateTimeOffset.MinValue),
                _ => _desc ? o.ThenByDescending(h => Array.IndexOf(TierResult.Order, h.Tier.Tier)) : o.ThenBy(h => Array.IndexOf(TierResult.Order, h.Tier.Tier)).ThenBy(h => h.OpenRed is null).ThenBy(h => h.MainSuccessRate ?? 2),
            };
            return o;
        }
    }

    private void Sort(string key) { if (_sort == key) _desc = !_desc; else { _sort = key; _desc = false; } }

    private static MarkupString TierMove(RepoHealth h)
    {
        if (h.PreviousTier is null || h.PreviousTier == h.Tier.Tier) return new("");
        var up = Array.IndexOf(TierResult.Order, h.Tier.Tier) > Array.IndexOf(TierResult.Order, h.PreviousTier);
        return new(up ? $"<span class='tone-ok' title='was {h.PreviousTier} 4 weeks ago'>▲</span>" : $"<span class='tone-bad' title='was {h.PreviousTier} 4 weeks ago'>▼</span>");
    }

    private static MarkupString TemplateSummary(RepoHealth h)
    {
        if (h.Templates.Count == 0) return new("<span class='tone-muted'>—</span>");
        var non = h.Templates.Count(t => t.RefStatus == TemplateRefStatus.NonCompliant);
        var exp = h.Templates.Count(t => t.RefStatus == TemplateRefStatus.Experimental);
        var none = h.Templates.Count(t => t.RefStatus == TemplateRefStatus.NoTemplate);
        var stale = h.Templates.Count(t => t.Stale);
        var parts = new List<string>();
        if (non > 0) parts.Add($"<span class='pill pill--bad'>{non} off-branch</span>");
        if (none > 0) parts.Add($"<span class='pill pill--bad'>{none} no templates</span>");
        if (exp > 0) parts.Add($"<span class='pill pill--info'>{exp} next</span>");
        if (stale > 0) parts.Add($"<span class='pill pill--warn' title='last run used an older template commit than the branch head'>{stale} stale</span>");
        return new(parts.Count == 0 ? "<span class='pill pill--ok'>main</span>" : string.Join(" ", parts));
    }
}
