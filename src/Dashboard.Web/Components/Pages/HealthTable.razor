@page "/repos"
@inherits LivePage
@inject HealthService HealthSvc

<PageTitle>Repos · DevOps Dashboard</PageTitle>

@{
    var w = Config.Current.Metrics.WindowDays;
    var redNow = _all.Count(h => h.OpenRed is not null && !h.IsTestRepo);
}
<header class="page-head">
    <div class="page-head__text">
        <h1>Repos</h1>
        <p class="page-head__headline"><strong class="@(redNow > 0 ? "tone-bad" : "")">@redNow repo@(redNow == 1 ? "" : "s")</strong> with main red · @_all.Count repos · metrics over @w d <Info Text="Tiers are cumulative gates: a repo is Gold only if every Bronze, Silver and Gold rule passes. * = provisional (the next tier is blocked only by rules with insufficient data)." Term="tier" /></p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--secondary btn--sm" href="export/health.md" target="_blank">Export Markdown</a>
    </div>
</header>

@if (LoadError is not null) { <div class="banner banner--bad">@LoadError</div> }

<div class="kpi-row mb-4">
    @foreach (var t in TierResult.Order.Reverse())
    {
        var prov = _all.Count(h => h.Tier.Tier == t && h.Tier.Provisional);
        <button type="button" class="kpi @(_tier == t ? "is-active" : "")" title="Filter the table to @t" aria-pressed="@(_tier == t)" @onclick="() => _tier = _tier == t ? string.Empty : t">
            <div class="kpi__label"><TierBadge Tier="@t" /></div><div class="kpi__value">@_all.Count(h => h.Tier.Tier == t) <small>repos</small></div>
            @if (prov > 0) { <div class="kpi__sub">@prov provisional</div> }
        </button>
    }
    <div class="kpi @(redNow > 0 ? "kpi--bad" : "")"><div class="kpi__label">Main red <span class="kpi__window">now</span></div><div class="kpi__value">@redNow <small>repos</small></div>@if (_all.Count(h => h.OpenRed is not null && h.IsTestRepo) is > 0 and var tf) { <div class="kpi__sub">+@tf test repo@(tf == 1 ? "" : "s") failing</div> }</div>
    <div class="kpi"><div class="kpi__label">Wasted on flaky re-runs <span class="kpi__window">@w d</span></div><div class="kpi__value">@_all.Where(h => !h.IsTestRepo).Sum(h => h.WastedMinutes).ToString("#,0") <small>min</small></div><div class="kpi__sub">re-runs that later went green@(_all.Any(h => h.IsTestRepo) ? $" · test repos +{_all.Where(h => h.IsTestRepo).Sum(h => h.WastedMinutes):0}" : "")</div></div>
</div>

<div class="filters">
    <input type="search" class="input" placeholder="Filter repos…" @bind="_filter" @bind:event="oninput" />
    <label>Type <select class="select" @bind="_type"><option value="">all</option><option>Service</option><option>Library</option><option>Infra</option><option value="E2E">E2E tests</option><option value="Load">Load tests</option></select></label>
    <label>Tier <select class="select" @bind="_tier"><option value="">all</option><option>Gold</option><option>Silver</option><option>Bronze</option><option>None</option></select></label>
    <label><input type="checkbox" @bind="_changed" /> changed this week</label>
    <label><input type="checkbox" @bind="_redOnly" /> red now</label>
    <label><input type="checkbox" @bind="_showMuted" /> show muted</label>
    <label><input type="checkbox" @bind="_tiles" /> tiles</label>
</div>

@{ var rows = Rows.ToList(); var active = rows.Where(h => !NoData(h)).ToList(); var idle = rows.Where(NoData).ToList(); }
@if (!_tiles)
{
<div class="table-wrap panel p-0">
<table class="t">
    <thead>
        <tr>
            <th class="sortable" @onclick='() => Sort("name")'>Repo</th>
            <th class="sortable" @onclick='() => Sort("tier")'>Tier · next gap <Info Text="Highest tier whose rules all pass, and the rules that block the next tier (hover for all)." Term="tier" /></th>
            <th class="sortable num" @onclick='() => Sort("success")'>Main % <span class="kpi__window">@w d · 12 wk</span> <Info Text="Final build-stage outcome pass ÷ (pass+fail), default-branch non-PR runs. succeededWithIssues = fail; cancelled/skipped excluded. n = completed runs. Sparkline = weekly rate over 12 weeks." Term="n" /></th>
            <th class="sortable num" @onclick='() => Sort("flaky")'>Flaky % <span class="kpi__window">@w d</span> <Info Text="Runs with ≥1 job whose earlier attempt failed and final attempt passed ÷ completed runs." /></th>
            <th class="sortable num" @onclick='() => Sort("review")'>1st review <span class="kpi__window">working h</span> <Info Text="Working hours from publish to first human non-author vote/comment. Median when n<20, p85 when n≥20." Term="p85" /></th>
            <th class="sortable" @onclick='() => Sort("prod")'>Last prod</th>
            <th class="sortable num" @onclick='() => Sort("findings")'>Open findings</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var h in active) { @RowFragment(h) }
    </tbody>
</table>
</div>
@if (idle.Count > 0)
{
    <details class="panel mt-4">
        <summary>No data (@idle.Count) — dormant or no completed main runs in @w d</summary>
        <div class="table-wrap mt-2">
        <table class="t compact"><tbody>
        @foreach (var h in idle) { @RowFragment(h) }
        </tbody></table>
        </div>
    </details>
}
}
else
{
    <div class="grid-3">
    @foreach (var h in rows)
    {
        <div class="panel">
            <header class="panel__head"><h2><a href="repo/@Uri.EscapeDataString(h.Repo.Name)">@h.Repo.Name</a></h2><span class="panel__meta"><TierBadge Tier="@h.Tier.Tier" Provisional="h.Tier.Provisional" /></span></header>
            <div class="row text-sm">
                <span>Main @Fmt.Pct(h.MainSuccessRate)</span><span>Flaky @Fmt.Pct1(h.FlakyRunRate)</span><span>1st review @(h.Prs.FirstReviewHours is { } fr ? $"{fr:0.#} h" : "—")</span>
                @if (h.OpenRed is not null) { <span class="pill pill--bad">main red</span> }
            </div>
            <Spark Points="h.Weekly.Select(w => w.SuccessRate).ToList()" Min="0" Max="1" Width="260" />
        </div>
    }
    </div>
}

@code {
    private IReadOnlyList<RepoHealth> _all = [];
    private string _filter = "", _type = "", _tier = "", _sort = "tier";
    private bool _desc, _changed, _redOnly, _showMuted, _tiles;

    protected override async Task LoadAsync() => _all = await HealthSvc.GetAllAsync();

    private IEnumerable<RepoHealth> Rows
    {
        get
        {
            var q = _all.Where(h => (_showMuted || !h.Repo.Muted)
                                    && (_filter.Length == 0 || h.Repo.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase))
                                    && (_type.Length == 0 || h.Type.ToString() == _type)
                                    && (_tier.Length == 0 || h.Tier.Tier == _tier)
                                    && (!_redOnly || h.OpenRed is not null)
                                    && (!_changed || (h.PreviousTier is not null && h.PreviousTier != h.Tier.Tier) || h.Weekly.Count > 1 && Math.Abs((h.Weekly[^1].SuccessRate ?? 0) - (h.Weekly[^2].SuccessRate ?? 0)) > 0.1));
            // Default "worst first": tier asc, then red, then success rate asc. Pinned first.
            IOrderedEnumerable<RepoHealth> o = q.OrderByDescending(h => h.Repo.Pinned);
            o = _sort switch
            {
                "name" => _desc ? o.ThenByDescending(h => h.Repo.Name) : o.ThenBy(h => h.Repo.Name),
                "success" => _desc ? o.ThenByDescending(h => h.MainSuccessRate ?? 2) : o.ThenBy(h => h.MainSuccessRate ?? 2),
                "flaky" => _desc ? o.ThenBy(h => h.FlakyRunRate ?? -1) : o.ThenByDescending(h => h.FlakyRunRate ?? -1),
                "wasted" => _desc ? o.ThenBy(h => h.WastedMinutes) : o.ThenByDescending(h => h.WastedMinutes),
                "review" => _desc ? o.ThenBy(h => h.Prs.FirstReviewHours ?? -1) : o.ThenByDescending(h => h.Prs.FirstReviewHours ?? -1),
                "findings" => _desc ? o.ThenBy(h => h.OpenFindings) : o.ThenByDescending(h => h.OpenFindings),
                "oldest" => _desc ? o.ThenBy(h => h.Prs.OldestActiveWorkingDays ?? -1) : o.ThenByDescending(h => h.Prs.OldestActiveWorkingDays ?? -1),
                "red" => _desc ? o.ThenBy(h => h.OpenRed?.Start ?? DateTimeOffset.MaxValue) : o.ThenBy(h => h.OpenRed is null).ThenBy(h => h.OpenRed?.Start),
                "prod" => _desc ? o.ThenByDescending(h => h.LastProductionDeploy?.FinishTime) : o.ThenBy(h => h.LastProductionDeploy?.FinishTime ?? DateTimeOffset.MinValue),
                _ => _desc ? o.ThenByDescending(h => Array.IndexOf(TierResult.Order, h.Tier.Tier)) : o.ThenBy(h => Array.IndexOf(TierResult.Order, h.Tier.Tier)).ThenBy(h => h.OpenRed is null).ThenBy(h => h.MainSuccessRate ?? 2),
            };
            return o;
        }
    }

    private static bool NoData(RepoHealth h) => h.Dormant || h.CompletedBuildRuns == 0;

    private RenderFragment RowFragment(RepoHealth h) => __builder =>
    {
        <tr class="@(h.OpenRed is not null && !h.IsTestRepo ? "is-bad" : "")">
            <td class="nowrap"><a href="repo/@Uri.EscapeDataString(h.Repo.Name)"><b>@h.Repo.Name</b></a>
                @if (h.OpenRed is { } red) { <span class="pill pill--bad" title="Main red since @red.Start.ToString("u")">✕ red @Fmt.Hours((Now - red.Start).TotalHours)</span> }
                @if (h.Repo.Pinned) { <span class="pill pill--info">pinned</span> } @if (h.Dormant) { <span class="pill">dormant</span> } @if (h.Repo.Muted) { <span class="pill">muted</span> }
                <div class="text-sm tone-muted">@RepoTypes.Label(h.Type)@if (h.Components.Count > 0) { <span title="@string.Join("\n", h.Components.Select(c => c.Name))"> · @h.Components.Count component@(h.Components.Count == 1 ? "" : "s")</span> }</div></td>
            <td class="wrap"><TierBadge Tier="@h.Tier.Tier" Provisional="h.Tier.Provisional" /> @TierMove(h)
                @if (h.Tier.NextTier is { } nt && h.Tier.NextTierGaps.Count > 0)
                {
                    var first = h.Tier.NextTierGaps[0];
                    <div class="text-sm tone-muted" title="@string.Join("\n", h.Tier.NextTierGaps.Select(g => $"{g.RuleId} {g.Title}: {g.Display} ({g.Status})"))">→ @nt: @first.Title@(h.Tier.NextTierGaps.Count > 1 ? $" +{h.Tier.NextTierGaps.Count - 1} more" : "")</div>
                }
                else if (h.Tier.NextTier is null) { <div class="text-sm tone-muted">top tier</div> }</td>
            <td class="num @(h.MainSuccessRate < 0.9 && !h.IsTestRepo ? "tone-bad" : "")" title="@(h.IsTestRepo ? "Test pass rate on main (test repo)" : "")">
                <div class="row">@Fmt.Pct(h.MainSuccessRate) <span class="tone-subtle text-sm">n=@h.CompletedBuildRuns</span></div>
                <Spark Points="h.Weekly.Select(w => w.SuccessRate).ToList()" Min="0" Max="1" Width="96" Height="20" Label="weekly main success rate, 12 weeks" /></td>
            <td class="num @(h.FlakyRunRate >= 0.05 ? "tone-warn" : "")">@Fmt.Pct1(h.FlakyRunRate)</td>
            <td class="num">@(h.Prs.FirstReviewHours is { } fr ? $"{fr:0.#} h" : "—") <div class="tone-subtle text-sm">@h.Prs.FirstReviewLabel n=@h.Prs.ReviewedInWindow</div></td>
            <td class="nowrap">@if (h.LastProductionDeploy is { } lp) { <Ago At="lp.FinishTime" /> <div class="tone-muted text-sm">@lp.EnvironmentName</div> } else { <span class="tone-subtle">never</span> }</td>
            <td class="num">@if (h.LatestAudit is null) { <span class="tone-subtle" title="not audited yet">—</span> } else if (h.OpenFindings > 0) { <a href="repo/@Uri.EscapeDataString(h.Repo.Name)?tab=audit"><span class="pill pill--warn">@h.OpenFindings</span></a> } else { <span>0</span> }</td>
        </tr>
    };

    private void Sort(string key) { if (_sort == key) _desc = !_desc; else { _sort = key; _desc = false; } }

    private static MarkupString TierMove(RepoHealth h)
    {
        if (h.PreviousTier is null || h.PreviousTier == h.Tier.Tier) return new("");
        var up = Array.IndexOf(TierResult.Order, h.Tier.Tier) > Array.IndexOf(TierResult.Order, h.PreviousTier);
        return new(up ? $"<span class='tone-ok' title='was {h.PreviousTier} 4 weeks ago'>▲</span>" : $"<span class='tone-bad' title='was {h.PreviousTier} 4 weeks ago'>▼</span>");
    }
}
