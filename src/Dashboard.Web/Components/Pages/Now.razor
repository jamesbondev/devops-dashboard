@page "/"
@inherits LivePage
@inject NowService NowSvc
@inject UserStateService UserState

<PageTitle>Now · DevOps Dashboard</PageTitle>

<header class="page-head">
    <div class="page-head__text">
        <h1>Now</h1>
        @if (_model is { } hm)
        {
            var red = hm.Attention.Count(a => a.Kind == AttentionKind.MainRed);
            var mine = hm.Attention.Count(a => a.Kind is AttentionKind.ApprovalForMe or AttentionKind.GateBlocked);
            <p class="page-head__headline"><strong class="@(red > 0 ? "tone-bad" : "")">@red repo@(red == 1 ? "" : "s")</strong> with main red · @mine approval@(mine == 1 ? "" : "s") waiting · @hm.Running.Count running · as of <Ago At="hm.GeneratedAt" /></p>
        }
    </div>
</header>

@if (LoadError is not null) { <div class="banner banner--bad">@LoadError</div> }
@if (Loading && _model is null) { <div class="empty">Loading…</div> }
else if (_model is { } m)
{
    var sl = m.SinceLastLooked;
    var slEmpty = sl.Failures == 0 && sl.Merged == 0 && sl.ProdDeploys == 0 && sl.NewApprovals == 0;
    var window = sl.Since is { } since ? "since " + Config.WorkingHours.ToLocal(since).ToString("ddd HH:mm") : "24h";
    <div class="stack">
    @foreach (var panel in Config.Current.NowView.Panels.OrderBy(p => IsEmpty(p, m, slEmpty)))
    {
        switch (panel)
        {
            case "sinceLastLooked":
                <section class="panel @(slEmpty ? "is-empty" : "")" data-empty="@($"Nothing new {window}")">
                    <header class="panel__head"><h2>Since you last looked</h2>@if (!slEmpty) { <span class="panel__meta">@window</span> }</header>
                    <div class="panel__body">
                    <div class="kpi-row">
                        <div class="kpi @(sl.Failures > 0 ? "kpi--bad" : "")"><div class="kpi__label">Main/CI failures <span class="kpi__window">@window</span></div><div class="kpi__value">@sl.Failures</div></div>
                        <div class="kpi"><div class="kpi__label">PRs merged <span class="kpi__window">@window</span></div><div class="kpi__value">@sl.Merged</div></div>
                        <div class="kpi"><div class="kpi__label">Production deploys <span class="kpi__window">@window</span></div><div class="kpi__value">@sl.ProdDeploys</div><div class="kpi__sub">sim + prod</div></div>
                        <div class="kpi @(sl.NewApprovals > 0 ? "kpi--warn" : "")"><div class="kpi__label">New approvals for you <span class="kpi__window">@window</span></div><div class="kpi__value">@sl.NewApprovals</div></div>
                    </div>
                    </div>
                </section>
                break;
            case "attention":
                <section class="panel">
                    <header class="panel__head"><h2>Needs attention</h2><span class="pill pill--count @(m.Attention.Count > 0 ? "pill--bad" : "")">@m.Attention.Count</span>
                        <Info Text="Ranked: your approvals → blocked gates → main red → failed Production deploy → slow release → stuck PR → failed PR validation." Term="attention" /></header>
                    @if (m.Attention.Count == 0) { <div class="empty">Nothing needs you right now.</div> }
                    <ul class="att-list">
                        @foreach (var a in m.Attention.Take(_showAll ? 500 : 25))
                        {
                            <li class="att att--@Tone(a.Kind)">
                                <div class="att__body">
                                    <div>@if (a.Badge is not null) { <span class="pill pill--bad">@a.Badge</span> } <a class="att__title" href="repo/@Uri.EscapeDataString(a.RepoName)">@a.Title</a></div>
                                    <div class="att__detail">@a.Detail</div>
                                </div>
                                <div class="att__side"><Ago At="a.Since" /><AdoLink Href="@a.Link">Open in ADO ↗</AdoLink></div>
                            </li>
                        }
                    </ul>
                    @if (m.Attention.Count > 25 && !_showAll) { <button class="btn btn--secondary btn--sm mt-2" @onclick="() => _showAll = true">Show all @m.Attention.Count</button> }
                </section>
                break;
            case "matrix":
                <section class="panel">
                    <header class="panel__head"><h2>Components × environments</h2><Info Text="Latest successful deployment per component and environment (from pipeline stages). Legend: '= same' = same version as the environment to its left; ⚠ = sim and prod run different versions (drift); +N = commits merged since the deployed build was queued; '—' = never deployed. A coloured pill = deployed from a non-default branch." Term="same" />
                        <span class="panel__meta row">
                            <label class="check"><input type="checkbox" @bind="_changesOnly" /> changes only</label>
                            <label class="check"><input type="checkbox" @bind="_matrixProdOnly" /> only with Production deploys</label>
                        </span></header>
                    <DeployMatrix Rows="m.Matrix.Where(r => !_matrixProdOnly || r.Cells.Values.Any(c => c.Latest?.Tier == EnvironmentTier.Production))" Environments="m.Environments" ChangesOnly="_changesOnly" />
                </section>
                break;
            case "running":
                <section class="panel @(m.Running.Count == 0 ? "is-empty" : "")" data-empty="Nothing running">
                    <header class="panel__head"><h2>Running &amp; queued</h2>@if (m.Running.Count > 0) { <span class="pill pill--count pill--info">@m.Running.Count</span> }</header>
                    <div class="panel__body table-wrap">
                        <table class="t">
                            <thead><tr><th>Repo</th><th>Pipeline</th><th>Build</th><th>Stage</th><th>Reason</th><th class="person">By</th><th>Queued</th></tr></thead>
                            <tbody>
                            @foreach (var r in m.Running)
                            {
                                <tr>
                                    <td class="nowrap"><a href="repo/@Uri.EscapeDataString(r.RepoName)">@r.RepoName</a></td>
                                    <td class="wrap">@r.PipelineName</td>
                                    <td class="nowrap"><AdoLink Href="@r.Run.WebUrl">@r.Run.BuildNumber</AdoLink></td>
                                    <td class="wrap">@if (r.WaitingApproval) { <span class="pill pill--warn">waiting approval</span> } @(r.CurrentStage ?? (r.Run.Status == "notStarted" ? "queued" : "—")) @if (r.Environment is not null) { <span class="tone-muted text-sm">→ @r.Environment</span> }</td>
                                    <td class="nowrap tone-muted">@r.Run.Reason</td>
                                    <td class="nowrap person tone-muted">@r.Run.RequestedFor</td>
                                    <td class="nowrap"><Ago At="r.Run.QueueTime" /></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </section>
                break;
            case "shipped":
                <section class="panel @(m.Shipped.Count == 0 ? "is-empty" : "")" data-empty="@($"Nothing shipped in {Config.Current.NowView.ShippedHours}h")">
                    <header class="panel__head"><h2>Shipped <span class="kpi__window">last @Config.Current.NowView.ShippedHours h</span></h2>@if (m.Shipped.Count > 0) { <span class="pill pill--count">@m.Shipped.Count</span> }</header>
                    <div class="panel__body table-wrap">
                        <table class="t compact">
                            <tbody>
                            @foreach (var sh in m.Shipped)
                            {
                                <tr><td class="nowrap"><Ago At="sh.At" /></td><td class="nowrap"><span class="pill">@(sh.Kind == "deploy" ? "deploy" : "merge")</span></td><td class="nowrap"><a href="repo/@Uri.EscapeDataString(sh.RepoName)">@sh.RepoName</a></td><td class="wrap"><AdoLink Href="@sh.Link">@sh.What</AdoLink></td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </section>
                break;
        }
    }
    </div>
}

@code {
    private static bool IsEmpty(string panel, NowModel m, bool slEmpty) => panel switch
    {
        "sinceLastLooked" => slEmpty,
        "running" => m.Running.Count == 0,
        "shipped" => m.Shipped.Count == 0,
        _ => false,
    };

    private NowModel? _model;
    private bool _showAll;
    private bool _matrixProdOnly;
    private bool _changesOnly = true;
    private DateTimeOffset? _lastLooked;
    private bool _markedSeen;

    protected override async Task LoadAsync()
    {
        if (!_markedSeen) _lastLooked = await UserState.GetDateAsync("lastLooked");
        _model = await NowSvc.BuildAsync(_lastLooked);
        if (!_markedSeen)
        {
            _markedSeen = true;
            await UserState.SetDateAsync("lastLooked", Clock.UtcNow);
        }
    }

    private static string Tone(AttentionKind k) => k switch
    {
        AttentionKind.ApprovalForMe or AttentionKind.GateBlocked => "you",
        AttentionKind.MainRed or AttentionKind.ProductionDeployFailed => "bad",
        AttentionKind.StuckRelease or AttentionKind.TestsFailing => "warn",
        _ => "info",
    };
}
