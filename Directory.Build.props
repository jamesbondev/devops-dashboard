<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873 (LoggerMessage delegates) and CA2007 are noise for a single-user app. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1031;CA1062;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1716;CA1720;CA1724;CA1002;CA1056;CA1054;CA1055;CA2227;CA1819;CA1308;CA5394;CA1515;CA1812;CA1852;CA1822;CA1859;CA1860;CA1861;CA1865;CA1866;CA1847;CA2201;CA1051;CA1034;CA1711;CA1805;CA1063;CA1816;CA2000;CA1001;CA1849;CA1823;CA1806;CA1069;CA1707;CA2234;CA1863;CA1869;CA1725;CA5350;CA5351;CA1068;CA1032;CA1064;CA2016;MCPSDK001</NoWarn>
  </PropertyGroup>
</Project>
